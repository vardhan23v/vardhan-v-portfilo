# Web3Forms access key for the contact forms (https://web3forms.com — free, no backend needed).
# Create one for 23vvardhan@gmail.com and set this in Vercel → Project → Environment Variables.
# When unset, the forms fall back to opening the visitor's mail app with a prefilled mailto: link.
VITE_WEB3FORMS_KEY=

# ---------------------------------------------------------------------------
# Vardhan AI (RAG assistant) — SERVER-ONLY. Never prefix these with VITE_:
# anything VITE_* is bundled into the public JavaScript.
# See docs/RAG_ASSISTANT.md for the full setup.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=25000

# Embeddings are separate from Groq (Groq chat models are not embedding models).
# Any OpenAI-compatible /embeddings endpoint. Dimensions must match vector(1024) (see supabase/migrations). Default: Jina, free tier.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSIONS=1024

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

GITHUB_USERNAME=vardhan23v
# Fine-grained token with public-repository read access only (raises the rate limit 60 → 5000/h).
GITHUB_TOKEN=

# Admin routes: at least 24 random characters, e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=
# Set automatically by Vercel when crons are enabled; used by the nightly /api/admin/sync.
CRON_SECRET=

SITE_URL=https://vardhan-v-portfilo.vercel.app
# Extra comma-separated origins allowed to call /api/chat (preview domains, custom domain).
ALLOWED_ORIGINS=

RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_CHUNK_TOKENS=700
RAG_CHUNK_OVERLAP=100
RAG_MAX_CONTEXT_TOKENS=3500
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=150
